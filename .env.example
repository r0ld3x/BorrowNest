# BorrowNest environment. Copy to .env.local (git-ignored) and fill in.
# Stage 1 pages work without these; account features need all three.
#
# Supabase Dashboard -> Project Settings -> API Keys:
#   - Project URL
#   - Publishable key (sb_publishable_...). Safe for browsers; RLS enforces access.
#
# NEVER put a secret / service_role key in a NEXT_PUBLIC_ variable, and do not
# add one to this app: ordinary requests run as the signed-in user.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY (no NEXT_PUBLIC_ prefix). HMAC key that lets the server vouch for
# product photos it has decoded. Generate it, and store the same value in
# Supabase Vault, with: bash supabase/operator/set-image-attestation-key.sh
IMAGE_ATTESTATION_SECRET=

# Public origin used in confirmation and password-reset email links.
# Must also be listed in Supabase Dashboard -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
